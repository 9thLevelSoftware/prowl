# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# Add AI connections on the Settings page: sign in with ChatGPT or Google, or paste an API key
# for almost any provider. Keys and tokens entered there are encrypted on this computer.
#
# Legacy option: configure one provider here instead. It only takes effect when no connection
# exists yet and matching credentials are set below. One of: openai | chatgpt-oauth | gemini | gemini-oauth | anthropic
PROWL_LLM_PROVIDER=
PROWL_MODEL_SMART=
PROWL_MODEL_FAST=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# For the legacy OAuth providers: a command that prints a token, a token file, or a raw token
PROWL_LLM_TOKEN_CMD=
PROWL_LLM_TOKEN_FILE=
PROWL_LLM_ACCESS_TOKEN=
PROWL_GOOGLE_PROJECT=

# Optional OpenAI-compatible base URL override for catalog/local/custom endpoints
# (packages/llm/src/providers.ts). Empty = provider catalog default.
PROWL_LLM_BASE_URL=

# Upper bound for one AI call in ms (packages/llm/src/client.ts). Default: 900000 (15 min).
PROWL_LLM_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# Adzuna aggregator (free tier: https://developer.adzuna.com/)
# ---------------------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Where local data lives (database, documents, screenshots, browser profile, encrypted secrets)
PROWL_DATA_DIR=./data

# SQLite file path. Default: <PROWL_DATA_DIR>/prowl.sqlite (packages/db/src/client.ts).
# Migration from Job Hunter: point this at data/job-hunter.sqlite, or copy/rename that file
# (plus -wal/-shm) to data/prowl.sqlite.
PROWL_DB_PATH=

# Ports / process identity
# Worker control API port (live): packages/shared/src/config.ts WORKER_PORT; worker binds 127.0.0.1.
PROWL_WORKER_PORT=3031
# PROWL_WEB_PORT is documented for operators only. Nothing in the repo reads it today:
# apps/web/package.json scripts hardcode `next dev/start -p 3000`. To change the web port,
# edit those scripts or launch Next with `-p <port>`. Do not assume this env var moves :3000.
PROWL_WEB_PORT=3000

# Second Next dev/start instance (for example demo data under ./data-demo): set a distinct
# build dir so Next does not clobber .next (apps/web/next.config.ts distDir).
PROWL_NEXT_DIST_DIR=

# Log level for @prowl/shared logger: debug | info | warn | error (packages/shared/src/log.ts). Default: info.
PROWL_LOG_LEVEL=

# Secrets (packages/llm/src/secrets.ts)
# Encrypted material file. Default: <PROWL_DATA_DIR>/secrets.json
PROWL_SECRETS_FILE=
# Set to 1 to skip OS keychain and keep the master key in data/secrets.key (tests use this).
PROWL_SECRETS_NO_KEYCHAIN=

# Set to 1 to skip models.dev catalog network refresh and use the bundled snapshot
# (packages/llm/src/catalog.ts). Offline tests set this.
PROWL_CATALOG_OFFLINE=

# Local embeddings for match/tailor similarity (packages/core/src/embed.ts)
# PROWL_EMBED_MODEL=Xenova/all-MiniLM-L6-v2
# PROWL_EMBED_DISABLE=1   # force TF-IDF fallback; vitest sets this for the default suite

# Applier browser: "chrome" uses installed Google Chrome, "chromium" uses Playwright's bundled build
PROWL_BROWSER_CHANNEL=chrome
