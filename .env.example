# ---------------------------------------------------------------------------
# LLM provider. One of: openai | chatgpt-oauth | gemini | gemini-oauth | anthropic
# ---------------------------------------------------------------------------
JH_LLM_PROVIDER=gemini-oauth

# Models per task tier (defaults are chosen per provider if blank)
JH_MODEL_SMART=
JH_MODEL_FAST=

# --- API-key auth (openai / gemini / anthropic) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- OAuth bearer auth (chatgpt-oauth / gemini-oauth) ---
# Option A: a command that prints a fresh access token to stdout.
#   e.g. gcloud auth application-default print-access-token
JH_LLM_TOKEN_CMD=
# Option B: a JSON credentials file written by a CLI login
#   (e.g. ~/.codex/auth.json or ~/.gemini/oauth_creds.json)
JH_LLM_TOKEN_FILE=
# Option C: a raw access token (short-lived; for testing)
JH_LLM_ACCESS_TOKEN=
# Optional overrides
JH_LLM_BASE_URL=
# Google Cloud project to bill for Gemini OAuth calls (x-goog-user-project)
JH_GOOGLE_PROJECT=

# ---------------------------------------------------------------------------
# Adzuna aggregator (free tier: https://developer.adzuna.com/)
# ---------------------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Where local data lives (sqlite db, rendered documents, screenshots, browser profile)
JH_DATA_DIR=./data

# Ports
JH_WEB_PORT=3000
JH_WORKER_PORT=3031

# Applier browser: "chrome" uses installed Google Chrome, "chromium" uses Playwright's bundled build
JH_BROWSER_CHANNEL=chrome
