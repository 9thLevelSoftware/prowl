# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# Add AI connections on the Settings page: sign in with ChatGPT or Google, or paste an API key
# for almost any provider. Keys and tokens entered there are encrypted on this computer.
#
# Legacy option: configure one provider here instead. It only takes effect when no connection
# exists yet and matching credentials are set below. One of: openai | chatgpt-oauth | gemini | gemini-oauth | anthropic
PROWL_LLM_PROVIDER=
PROWL_MODEL_SMART=
PROWL_MODEL_FAST=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# For the legacy OAuth providers: a command that prints a token, a token file, or a raw token
PROWL_LLM_TOKEN_CMD=
PROWL_LLM_TOKEN_FILE=
PROWL_LLM_ACCESS_TOKEN=
PROWL_GOOGLE_PROJECT=

# ---------------------------------------------------------------------------
# Adzuna aggregator (free tier: https://developer.adzuna.com/)
# ---------------------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Where local data lives (database, documents, screenshots, browser profile, encrypted secrets)
PROWL_DATA_DIR=./data

# Ports
PROWL_WEB_PORT=3000
PROWL_WORKER_PORT=3031

# Applier browser: "chrome" uses installed Google Chrome, "chromium" uses Playwright's bundled build
PROWL_BROWSER_CHANNEL=chrome
