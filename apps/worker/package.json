{
  "name": "@prowl/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prowl/shared": "workspace:*",
    "@prowl/db": "workspace:*",
    "@prowl/llm": "workspace:*",
    "@prowl/core": "workspace:*",
    "@prowl/sources": "workspace:*",
    "@prowl/documents": "workspace:*",
    "@prowl/applier": "workspace:*",
    "croner": "^9.1.0",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.44.0",
    "@prowl/browser": "workspace:*"
  },
  "devDependencies": {}
}
